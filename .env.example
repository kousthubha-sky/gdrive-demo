# ---- Server ----
PORT=4000
NODE_ENV=development
# Public origin of the deployed app (no trailing slash). Used for OAuth callback + cookies.
APP_URL=http://localhost:4000
# Where the browser lands after login. In dev this is the Vite server.
WEB_URL=http://localhost:5173

# ---- Postgres (Neon) ----
# https://console.neon.tech -> project -> Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Google OAuth ----
# https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
# Authorised redirect URI must be exactly: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Session ----
# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ---- AWS S3 ----
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: set for S3-compatible storage (Cloudflare R2, MinIO). Leave blank for real AWS.
S3_ENDPOINT=

# Max upload size in bytes (default 100 MB)
MAX_UPLOAD_BYTES=104857600

# Quota shown by the sidebar storage meter (default 15 GB). Display only.
STORAGE_QUOTA_BYTES=16106127360
